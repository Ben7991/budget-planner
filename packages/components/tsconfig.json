{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@repo/components/atoms/*": ["./src/atoms/*/index.ts"],
      "@repo/components/molecules/*": ["./src/molecules/*/index.ts"],
      "@repo/components/organisms/*": ["./src/organisms/*/index.ts"],
      "@repo/components/templates/*": ["./src/templates/*/index.ts"],
      "@repo/components/lib/*": ["./src/lib/*"],
      "@repo/components/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src"]
}
  